# ---- Docker Compose (automatic) ----
# When using `docker compose up`, MONGODB_URI / BETTER_AUTH_SECRET / PORT
# are injected by docker-compose.yml. You only need to set OPENAI_API_KEY here.

OPENAI_API_KEY=sk-...

# ---- Standalone (manual) ----
# MONGODB_URI=mongodb://localhost:27017/supermemory?directConnection=true
# BETTER_AUTH_SECRET=your-secret-here
# BETTER_AUTH_URL=http://localhost:3100
# CORS_ORIGIN=http://localhost:3000
# PORT=3100
