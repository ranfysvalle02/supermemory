{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"paths": {
			"@repo/validation/*": ["../packages/validation/*"]
		},
		"types": ["bun-types"]
	},
	"include": ["src/**/*.ts"]
}
